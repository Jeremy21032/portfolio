      "javascript",
      "typescript",
      "react",
      "nodejs",
      "remix",
      "graphql",
      "prisma",
      "shopify",
      "liquid",
      "astro",
      "github-actions",
    ],
  },
  {
    date: "Julio 2023 - Abril 2024",
