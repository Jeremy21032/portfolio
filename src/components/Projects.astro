---
import GitHub from "./icons/GitHub.astro";
import NextJS from "./icons/NextJS.astro";
import ReactIcon from "./icons/React.astro";
import Tailwind from "./icons/Tailwind.astro";
import Javascript from "./icons/Javascript.astro";
import Link from "./icons/Link.astro";
import LinkButton from "./LinkButton.astro";
import Html from "./icons/Html.astro";
import Css from "./icons/Css.astro";
import Flutter from "./icons/Flutter.astro";
import Work from "./icons/Work.astro";
import ShopifyIcon from "./icons/Shopify.astro";

const TAGS = {
  NEXT: {
    name: "Next.js",
    class: "bg-black text-white",
    icon: NextJS,
    hoverColor: "hover:bg-gray-700",
  },
  TAILWIND: {
    name: "Tailwind CSS",
    class: "bg-[#003159] text-white",
    icon: Tailwind,
    hoverColor: "hover:bg-[#004179]",
  },
  JAVASCRIPT: {
    name: "JavaScript",
    class: "bg-[#565900] text-white",
    icon: Javascript,
    hoverColor: "hover:bg-[#989d00]",
  },
  HTML: {
    name: "Html",
    class: "bg-[#593600] text-white",
    icon: Html,
    hoverColor: "hover:bg-[#9d6800]",
  },
  CSS: {
    name: "Css",
    class: "bg-[#004959] text-white",
    icon: Css,
    hoverColor: "hover:bg-[#008a9d]",
  },
  FLUTTER: {
    name: "Flutter",
    class: "bg-[#004959] text-white",
    icon: Flutter,
    hoverColor: "hover:bg-[#008a9d]",
  },
  REACT: {
    name: "React",
    class: "bg-[#61dafb] text-black",
    icon: ReactIcon,
    hoverColor: "hover:bg-[#4fa8c5]",
  },
  SHOPIFY: {
    name: "Shopify",
    class: "bg-[#95BF47] text-white",
    icon: ShopifyIcon,
    hoverColor: "hover:bg-[#7a9d38]",
  },
};

// Proyectos basados en el CV de Jeremy León
const PROJECTS = [
  {
    title: "Apps Privadas para Shopify",
    description: "Desarrollo de aplicaciones privadas para Shopify utilizando Remix, Node.js, GraphQL y Prisma. Implementé Carrier Services para cálculo de tarifas, construcción de temas personalizados con Liquid, y diseño de microservicios para gestión de órdenes, logística y pagos. Incluye dashboards operativos desarrollados con Astro para monitoreo y métricas.",
    link: null,
    github: null,
    work: null,
    image: "/IXCOMERCIO.jpg",
    tags: [TAGS.JAVASCRIPT, TAGS.REACT, TAGS.TAILWIND],
  },
  {
    title: "Aplicación Móvil Banco Santander",
    description: "Desarrollo de aplicación móvil bancaria para Banco Santander utilizando servicios de COBIS TOPAZ. Implementada con React Native y TypeScript, incluyendo consumo de servicios corporativos, pruebas unitarias con Jest y JMeter, y despliegue en AWS con funciones Lambda y GraphQL.",
    link: null,
    github: null,
    work: null,
    image: "/tuiio.png",
    tags: [TAGS.REACT, TAGS.JAVASCRIPT],
  },
  {
    title: "MoneyBlinks",
    description: "Aplicación móvil financiera desarrollada en React Native con TypeScript. Integración con servicios de COBIS TOPAZ para operaciones bancarias, consumo de servicios corporativos y pruebas unitarias exhaustivas. Proyecto enfocado en la experiencia del usuario y seguridad de transacciones.",
    link: null,
    github: null,
    work: null,
    image: "/moneyblinks.png",
    tags: [TAGS.REACT, TAGS.JAVASCRIPT],
  },
  {
    title: "Sistema Bancario COBIS TOPAZ",
    description: "Desarrollo de software para producto bancario COBIS TOPAZ. Levantamiento de requerimientos y flujos transaccionales para clientes bancarios (FIE, FINCA, BANISTMO). Implementación en AWS con funciones Lambda, GraphQL, CloudWatch, ECS y EC2. Pruebas unitarias con Gherkin.",
    link: null,
    github: null,
    work: null,
    image: "/cobis.png",
    tags: [TAGS.JAVASCRIPT],
  }
];
---

<div class="flex flex-col gap-y-16">
  {
    PROJECTS.map(({ image, title, description, tags, link, github, work }) => (
      <article class="flex flex-col space-x-0 space-y-8 group md:flex-row md:space-x-8 md:space-y-0">
        <div class="w-full md:w-1/2">
          <div class="relative flex flex-col items-center col-span-6 row-span-5 gap-8 transition duration-500 ease-in-out transform shadow-xl overflow-clip rounded-xl sm:rounded-xl md:group-hover:-translate-y-1 md:group-hover:shadow-2xl lg:border lg:border-gray-800 lg:hover:border-gray-700 lg:hover:bg-gray-800/50">
            <img
              alt={title}
              class="object-cover object-top w-full h-56 transition duration-500 sm:h-full md:scale-110 md:group-hover:scale-105"
              loading="lazy"
              src={image}
            />
          </div>
        </div>

        <div class="w-full md:w-1/2 md:max-w-lg">
          <h3 class="text-2xl font-bold text-gray-800 dark:text-gray-100">
            {title}
          </h3>
          <div class="flex flex-wrap mt-2">
            <ul class="flex flex-row mb-2 gap-x-2">
              {tags.map((tag) => (
                <li>
                  <span
                    class={`flex gap-x-2 rounded-full text-xs ${tag.class} ${tag.hoverColor} transition-colors duration-200 py-1 px-2`}
                  >
                    <tag.icon class="size-4" />
                    {tag.name}
                  </span>
                </li>
              ))}
            </ul>

            <div class="mt-2 text-gray-700 dark:text-gray-400">
              {description}
            </div>
            <footer class="flex items-end justify-start mt-4 gap-x-4">
              {github && (
                <LinkButton href={github}>
                  <GitHub class="size-6" />
                  Code
                </LinkButton>
              )}
              {link && (
                <LinkButton href={link}>
                  <Link class="size-4" />
                  Preview
                </LinkButton>
              )}
              {work && (
                <LinkButton href={work}>
                  <Work class="size-4" />
                  Working on Website
                </LinkButton>
              )}
            </footer>
          </div>
        </div>
      </article>
    ))
  }
</div>
